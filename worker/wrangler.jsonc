{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "getpatched-release-gateway",
  "main": "src/index.js",
  "compatibility_date": "2026-10-25",
  "workers_dev": false,
  "routes": [
    { "pattern": "getpatched.dev", "custom_domain": true },
    { "pattern": "repo.getpatched.dev", "custom_domain": true },
    { "pattern": "early.getpatched.dev", "custom_domain": true }
  ],
  "assets": {
    "directory": "../site",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "r2_buckets": [
    { "binding": "RELEASES", "bucket_name": "getpatched-release-staging" }
  ],
  "triggers": { "crons": ["*/15 * * * *"] },
  "vars": {
    "GITHUB_API": "https://api.github.com",
    "PUBLIC_ORIGIN": "https://getpatched.dev"
  }
}
