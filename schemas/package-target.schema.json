{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://getpatched.dev/schemas/package-target.schema.json",
  "title": "GetPatched target-specific package build recipe",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "base", "source", "supportedSourceVersions", "packageVersion", "releaseSerial", "changelog", "binaryPackages", "patches", "releaseAccess", "status"],
  "properties": {
    "schemaVersion": {"const": 1}, "id": {"type": "string", "pattern": "^(ubuntu|debian)-[a-z0-9-]+-(amd64|arm64)$"},
    "base": {"type": "object", "additionalProperties": false, "required": ["distribution", "release", "codename", "sourcePocket", "architecture"], "properties": {"distribution": {"enum": ["Ubuntu", "Debian"]}, "release": {"type": "string"}, "codename": {"type": "string"}, "sourcePocket": {"type": "string"}, "architecture": {"enum": ["amd64", "arm64"]}}},
    "source": {"type": "object", "required": ["format", "version", "publication", "publishedAt", "descriptor", "files", "signatureVerification"], "properties": {"format": {"const": "3.0 (quilt)"}, "version": {"type": "string"}, "publication": {"type": "string", "format": "uri"}, "publishedAt": {"type": "string", "format": "date-time"}, "descriptor": {"$ref": "#/$defs/asset"}, "files": {"type": "array", "minItems": 2, "items": {"$ref": "#/$defs/asset"}}, "signatureVerification": {"type": "object", "required": ["verified", "note"], "properties": {"verified": {"type": "boolean"}, "note": {"type": "string"}}}}, "additionalProperties": false},
    "supportedSourceVersions": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "packageVersion": {"type": "string"}, "releaseSerial": {"type": "integer", "minimum": 1},
    "changelog": {"type": "object", "required": ["distribution", "urgency", "maintainer", "date"], "properties": {"distribution": {"type": "string"}, "urgency": {"enum": ["low", "medium", "high", "critical"]}, "maintainer": {"type": "string"}, "date": {"type": "string"}}},
    "binaryPackages": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}}, "patches": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}}, "buildPatches": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "releaseAccess": {"type": "object", "additionalProperties": false, "required": ["policy", "sponsorDelayHours", "sponsorEligibility", "earlyBinaryLicenseId", "publicContributionSpdx", "earlyUse", "earlyRedistributionAllowed", "publicBinaryLicenseSpdx"], "properties": {"policy": {"enum": ["sponsor-first", "public-after-checks"]}, "sponsorDelayHours": {"enum": [0, 168]}, "sponsorEligibility": {"enum": ["any-active-individual-github-sponsorship", null]}, "earlyBinaryLicenseId": {"enum": ["LicenseRef-GetPatched-Early-Binary-1.1", null]}, "publicContributionSpdx": {"const": "MIT"}, "earlyUse": {"const": ["private", "commercial"]}, "earlyRedistributionAllowed": {"const": false}, "publicBinaryLicenseSpdx": {"const": "MIT"}}},
    "status": {"type": "string"}
  },
  "$defs": {"asset": {"type": "object", "additionalProperties": false, "required": ["name", "url", "sha256", "bytes"], "properties": {"name": {"type": "string"}, "role": {"type": "string"}, "url": {"type": "string", "format": "uri"}, "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "bytes": {"type": "integer", "minimum": 1}}}}
}
