{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://getpatched.dev/schemas/patch-metadata.schema.json",
  "title": "GetPatched patch metadata",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "patches"],
  "properties": {"schemaVersion": {"const": 3}, "patches": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/patch"}}},
  "$defs": {
    "applicability": {
      "type": "object", "additionalProperties": false,
      "required": ["target"],
      "properties": {
        "target": {"type": "string"},
        "sourceVersion": {"type": "string"},
        "sourceVersionRange": {
          "type": "object", "additionalProperties": false,
          "properties": {"minimum": {"type": "string"}, "minimumInclusive": {"type": "boolean"}, "maximum": {"type": "string"}, "maximumInclusive": {"type": "boolean"}},
          "anyOf": [{"required": ["minimum", "minimumInclusive"]}, {"required": ["maximum", "maximumInclusive"]}]
        }
      },
      "oneOf": [{"required": ["sourceVersion"]}, {"required": ["sourceVersionRange"]}]
    },
    "patch": {
      "type": "object", "required": ["id", "kind", "file", "sha256", "title", "cves", "appliesTo", "tests"],
      "properties": {"id": {"type": "string"}, "kind": {"enum": ["security", "build-compatibility"]}, "file": {"type": "string"}, "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "title": {"type": "string"}, "cves": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}, "appliesTo": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/applicability"}}, "upstream": {"type": "object"}, "dep3": {"type": "object"}, "referenceFiles": {"type": "array"}, "tests": {"type": "array", "minItems": 1}}
    }
  }
}
