{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://getpatched.dev/schemas/platform-policy.schema.json",
  "title": "GetPatched platform policy",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "schema", "targets", "scanner", "licenses", "packages"],
  "properties": {
    "schemaVersion": {"const": 2},
    "schema": {"const": "schemas/platform-policy.schema.json"},
    "targets": {"type": "object", "minProperties": 1, "additionalProperties": {"$ref": "#/$defs/target"}},
    "scanner": {
      "type": "object", "additionalProperties": false,
      "required": ["image", "databaseReference", "databaseSha256"],
      "properties": {
        "image": {"type": "string", "pattern": "@sha256:[a-f0-9]{64}$"},
        "databaseReference": {"type": "string", "pattern": "@sha256:[a-f0-9]{64}$"},
        "databaseSha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "licenses": {
      "type": "object", "additionalProperties": false,
      "required": ["schemaVersion", "publicContributions", "earlyBinary"],
      "properties": {
        "schemaVersion": {"const": 1},
        "publicContributions": {
          "type": "object", "additionalProperties": false,
          "required": ["spdx", "licenseFile", "scope"],
          "properties": {"spdx": {"const": "MIT"}, "licenseFile": {"type": "string"}, "scope": {"type": "string"}}
        },
        "earlyBinary": {
          "type": "object", "additionalProperties": false,
          "required": ["licenseId", "termsFile", "eligibility", "permittedUse", "redistributionAllowed", "accessRevokedWhen", "scope", "upstreamRights"],
          "properties": {
            "licenseId": {"const": "LicenseRef-GetPatched-Early-Binary-1.1"},
            "termsFile": {"type": "string"},
            "eligibility": {"const": "any-active-individual-github-sponsorship"},
            "permittedUse": {"const": ["private", "commercial"]},
            "redistributionAllowed": {"const": false},
            "accessRevokedWhen": {"const": "sponsorship-inactive"},
            "scope": {"const": "official early-channel binary artifacts only"},
            "upstreamRights": {"type": "string"}
          }
        }
      }
    },
    "packages": {"type": "object", "minProperties": 1, "additionalProperties": {"$ref": "#/$defs/package"}}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "target": {
      "type": "object", "additionalProperties": false,
      "required": ["distribution", "releaseVersion", "codename", "architecture", "sourceBranch", "advisoryEcosystem", "packageEcosystem", "build", "repository", "archiveSnapshot", "baseImage", "aptSources"],
      "properties": {
        "distribution": {"enum": ["Ubuntu", "Debian"]},
        "releaseVersion": {"type": "string", "pattern": "^[0-9]+(\\.[0-9]+)*$"},
        "codename": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
        "architecture": {"enum": ["amd64", "arm64"]},
        "sourceBranch": {"type": "string", "pattern": "^getpatched/[a-z0-9][a-z0-9._/-]*$"},
        "advisoryEcosystem": {"type": "string", "minLength": 1},
        "packageEcosystem": {"type": "string", "minLength": 1},
        "build": {"type": "object", "additionalProperties": false, "required": ["runner", "containerPlatform"], "properties": {"runner": {"type": "string"}, "containerPlatform": {"type": "string", "pattern": "^linux/(amd64|arm64)$"}}},
        "repository": {"type": "object", "additionalProperties": false, "required": ["enabled"], "properties": {"enabled": {"type": "boolean"}, "suite": {"type": "string"}, "architecture": {"type": "string"}}},
        "archiveSnapshot": {"type": "string", "pattern": "^[0-9]{8}T[0-9]{6}Z$"},
        "baseImage": {"type": "string", "pattern": "@sha256:[a-f0-9]{64}$"},
        "aptSources": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["type", "uri", "suites", "components"], "properties": {"type": {"enum": ["deb", "deb-src", "both"]}, "uri": {"type": "string", "pattern": "^https://"}, "suites": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "components": {"type": "array", "minItems": 1, "items": {"type": "string"}}}}}
      }
    },
    "releaseAccess": {
      "type": "object", "additionalProperties": false,
      "required": ["policy", "sponsorDelayHours", "sponsorEligibility", "earlyBinaryLicenseId", "publicContributionSpdx", "earlyUse", "earlyRedistributionAllowed", "publicBinaryLicenseSpdx"],
      "properties": {
        "policy": {"enum": ["sponsor-first", "public-after-checks"]},
        "sponsorDelayHours": {"enum": [0, 168]},
        "sponsorEligibility": {"enum": ["any-active-individual-github-sponsorship", null]},
        "earlyBinaryLicenseId": {"enum": ["LicenseRef-GetPatched-Early-Binary-1.1", null]},
        "publicContributionSpdx": {"const": "MIT"},
        "earlyUse": {"const": ["private", "commercial"]},
        "earlyRedistributionAllowed": {"const": false},
        "publicBinaryLicenseSpdx": {"const": "MIT"}
      }
    },
    "packageTarget": {
      "type": "object", "additionalProperties": false,
      "required": ["baselineVersion", "sourcePocket", "packageVersion", "releaseSerial", "binaryPackages", "targetCve", "targetCves", "advisory", "candidateStatus", "releaseAccess"],
      "properties": {
        "baselineVersion": {"type": "string", "minLength": 1}, "sourcePocket": {"type": "string"},
        "packageVersion": {"type": "string", "minLength": 1}, "releaseSerial": {"type": "integer", "minimum": 1},
        "futureEsmVersion": {"type": "string"}, "esmPockets": {"type": "array", "items": {"type": "string"}}, "vendorFixedVersions": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "ubuntuProEsmCompatibility": {"type": "string"}, "binaryPackages": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "targetCve": {"type": "string"}, "targetCves": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
        "advisory": {"type": "string", "format": "uri"}, "candidateStatus": {"type": "string"}, "releaseAccess": {"$ref": "#/$defs/releaseAccess"}
      }
    },
    "package": {"type": "object", "additionalProperties": false, "required": ["targets"], "properties": {"targets": {"type": "object", "minProperties": 1, "additionalProperties": {"$ref": "#/$defs/packageTarget"}}}}
  }
}
