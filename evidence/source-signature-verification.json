  "verification_procedure": {
    "scope": "Re-fetch and replay the currently selected Ubuntu focal Updates/Security source signatures and libarchive upstream archive signature from a clean platform checkout. Lower focal Release reference records are outside this verification.",
    "requirements": "Python 3.10+, GnuPG 2.x, and network access to Launchpad HTTPS endpoints (including Launchpad file-host redirects) and keyserver.ubuntu.com.",
    "replay_command": "python3 scripts/verify-source-signatures.py",
    "behavior": "The committed script accepts HTTPS only from launchpad.net, Launchpad file-host redirects, and keyserver.ubuntu.com; fetches every descriptor, descriptor-listed archive, and public key into an automatically removed temporary directory; validates keyring primary fingerprints; parses each inline-signed descriptor and requires an exact filename/size/SHA-256 match between its signed Checksums-Sha256 field and the recorded member manifest; verifies all source hashes; verifies signatures in a temporary GNUPGHOME; and requires the recorded VALIDSIG signer fingerprint. Public-key export bytes are not pinned because keyserver re-exports may change without changing the key fingerprint.",
    "source_checkout_paths": "All evidence inputs are fetched by URL from a clean checkout; no files from the author workspace or AptTo/source-inputs are needed.",
    "observed_run": "The original verification was performed with GnuPG 2.5.19. On this macOS sandbox, key import emitted an agent IPC warning, but each individual signature verification returned status 0 with the recorded VALIDSIG. The replay script checks signature outcomes and fingerprints rather than relying on the import warning.",
    "cleanup": "Temporary downloaded files and the temporary GnuPG home are removed automatically on exit."
  }
